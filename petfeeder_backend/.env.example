PORT=3000
HOST=127.0.0.1
MQTT_BROKER_URL=mqtt://broker.emqx.io:1883
MQTT_TOPIC_PREFIX=duylinh0212/petfeeder/v1
DATABASE_URL=postgresql://USER:PASSWORD@HOST/petfeeder?sslmode=verify-full
# Optional: compact Firebase service-account JSON; keep this value out of Git.
FIREBASE_SERVICE_ACCOUNT_JSON=
# For local development, point to an ignored service-account JSON file instead.
FIREBASE_SERVICE_ACCOUNT_FILE=
# Set the same private broker/prefix in PetFeeder/include/secrets.h when needed.
